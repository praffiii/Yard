# Public browser configuration. Only VITE_ variables are exposed to the web bundle.
VITE_API_URL=http://127.0.0.1:8787
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Public/restricted Mapbox token for browser map rendering.
VITE_MAPBOX_ACCESS_TOKEN=pk_test_replace_me
VITE_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12

# Server-only TanStack Start configuration. Never prefix this with VITE_.
CLERK_SECRET_KEY=sk_test_replace_me
