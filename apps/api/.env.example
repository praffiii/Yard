HOST=127.0.0.1
PORT=8787
ALLOWED_ORIGINS=http://127.0.0.1:3000

# Local compose credentials and host port. Keep these values aligned with the
# connection strings below; use isolated development-only values.
POSTGRES_DB=yard_development
POSTGRES_USER=yard
POSTGRES_PASSWORD=yard_local_only
POSTGRES_HOST_PORT=54329

# Pooled runtime connection. Use `pg` for the local compose service or
# `neon` for a hosted Neon pooled connection.
DATABASE_RUNTIME_DRIVER=pg
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}

# Direct connection used only by Drizzle Kit migrations and administration.
# Never fall back to DATABASE_URL for this value.
DATABASE_DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/${POSTGRES_DB}

# Optional, isolated local database used by the focused migration test.
DATABASE_TEST_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@127.0.0.1:${POSTGRES_HOST_PORT}/yard_test
