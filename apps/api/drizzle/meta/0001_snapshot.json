        "users_account_status_check": {
          "name": "users_account_status_check",
          "value": "\"users\".\"account_status\" in ('active', 'suspended', 'deleted')"
        },
        "users_profile_photo_status_check": {
          "name": "users_profile_photo_status_check",
          "value": "\"users\".\"profile_photo_status\" is null or \"users\".\"profile_photo_status\" in ('pending', 'ready', 'failed', 'removed')"
        },
        "users_ready_profile_photo_check": {
          "name": "users_ready_profile_photo_check",
          "value": "\"users\".\"profile_photo_status\" <> 'ready' or (\"users\".\"profile_photo_key\" is not null and \"users\".\"profile_photo_width\" is not null and \"users\".\"profile_photo_height\" is not null)"
        },
        "users_profile_photo_width_check": {
          "name": "users_profile_photo_width_check",
          "value": "\"users\".\"profile_photo_width\" is null or \"users\".\"profile_photo_width\" > 0"
        },
