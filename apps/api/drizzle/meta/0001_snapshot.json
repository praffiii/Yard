      "policies": {},
      "checkConstraints": {
        "users_auth_provider_non_empty": {
          "name": "users_auth_provider_non_empty",
          "value": "length(btrim(\"users\".\"auth_provider\")) > 0"
        },
        "users_auth_subject_non_empty": {
